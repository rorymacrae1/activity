{
  "expo": {
    "name": "PeakWise",
    "slug": "piste-wise",
    "version": "1.1.0",
    "description": "Find your perfect ski resort. Personalised recommendations based on your skill level, budget, and style.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "peakwise",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a365d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peakwise.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.peakwise.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "backgroundColor": "#f8fafc",
      "themeColor": "#1a365d"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/5b0bc1c1-7aa4-41f5-afa2-ed176b24ac38"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "@sentry/react-native",
      "expo-secure-store",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "bundleSplitting": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b0bc1c1-7aa4-41f5-afa2-ed176b24ac38"
      }
    },
    "owner": "piste-wise"
  }
}
